[Unit]
Description=slopd — Claude agent session manager
Documentation=https://github.com/futpib/slopd
Requires=slopd-tmux.service
After=slopd-tmux.service

[Service]
ExecStart=%h/.cargo/bin/slopd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillMode=process

[Install]
WantedBy=default.target
